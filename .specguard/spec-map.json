{
  "system": {
    "title": "Practera Learner App",
    "problem": "Learners in work-integrated learning and experiential education programs need a unified platform to navigate their learning journey, complete assessments, collaborate with peers and mentors, and track their progress toward competencies. Without a cohesive mobile-first application, learners face fragmented experiences across multiple tools, making it difficult to stay engaged, submit work on time, communicate effectively with their team, and understand their development trajectory.",
    "users": [
      "Learners enrolled in experiential education programs",
      "Peer reviewers providing feedback on submissions",
      "Team members collaborating on group projects",
      "Mentors and coordinators monitoring learner progress"
    ],
    "value": "Practera provides learners with a single, mobile-responsive interface to access all learning activities, submit assessments, communicate with peers and mentors, track deadlines, and view their skill development—supporting engagement and success throughout their experiential learning journey.",
    "nonGoals": [
      "Content authoring or curriculum design tools for coordinators",
      "Administrative dashboards for program management",
      "Backend API implementation",
      "Learning management system (LMS) replacement for traditional classroom learning"
    ]
  },
