{
  "name": "practera-app-v2",
  "version": "3.2.1",
  "packageManager": "npm@11.6.2",
  "author": "Practera",
  "repository": "https://github.com/intersective/practera-app-v2",
  "homepage": "https://github.com/intersective/practera-app-v2",
  "description": "AppV2",
  "scripts": {
    "ng": "ng",
    "start": "npm run v3",
    "v3": "ng serve --project=v3 -c development --host 0.0.0.0 --port 4200 --disable-host-check --ssl true",
    "prev3:local": "npm run prebuildv3",
    "v3:local": "ng serve --project=v3 -c development --host 0.0.0.0 --port 4200 --disable-host-check",
    "proxy": "ng serve --project=v3 -c development --proxy-config proxy.conf.json",
    "prestart": "npm run prebuildv3",
    "prev3": "npm run prebuildv3",
    "buildv3": "ng build v3 -c development",
    "prebuildv3": "ng build request",
    "poststart": "npm run generate-version",
    "local": "ng serve -c local",
    "postlocal": "npm run generate-version",
    "development": "ng serve -c stage --host 0.0.0.0 --port 8080 --disable-host-check --ssl true",
    "build": "ng build",
    "postbuild": "npm run generate-version",
    "deploy": "ng build --base-href '/practera-app-v2/' && git commit -am 'Build to Github Page' && git subtree push --prefix www origin gh-pages",
    "postdeploy": "npm run generate-version",
    "test": "ng test v3 --no-watch",
    "check": "npm run lint && npm run test",
    "lint": "ng lint v3",
    "lint-fix": "ng lint --fix",
    "lintv3": "ng lint v3",
    "lintv3-fix": "ng lint v3 --fix",
    "generate-version": "node ./hooks/post-build.js",
    "generate-version-v3": "node ./hooks/post-buildv3.js",
    "pubdocs": "npx typedoc --entryPointStrategy expand --out documentation projects/v3/src && cp -R documentation/ www/ && ng deploy --base-href=/practera-app-v2/ --branch=typedoc-pages --no-build",
    "i18n": "ng extract-i18n v3 --output-path locales/",
    "serve:es": "ng serve --configuration=development --localize=es --port=4201",
    "serve:ja": "ng serve --configuration=development --localize=ja --port=4202",
    "serve:ms": "ng serve --configuration=development --localize=ms --port=4203"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^21.2.26",
    "@angular/animations": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@apollo/client": "^3.10.8",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@ionic/angular": "9.0.7",
    "@ionic/angular-toolkit": "^12.3.0",
    "@uppy/angular": "^1.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/tus": "^5.1.1",
    "apollo-angular": "^8.0.0",
    "color-convert": "^2.0.1",
    "dayjs": "^1.11.23",
    "exifr": "^7.1.3",
    "franc-min": "^6.2.0",
    "graphql": "^16.14.2",
    "h5p-standalone": "^3.8.2",
    "ics": "^3.12.1",
    "jspdf": "4.2.1",
    "marked": "^18.1.0",
    "ng-circle-progress": "~1.7.1",
    "ngx-quill": "^30.1.3",
    "plyr": "^3.8.5",
    "pusher-js": "^8.6.0",
    "quill": "^2.0.3",
    "quill-magic-url": "^4.2.0",
    "rxjs": "~7.8.0",
    "ts-md5": "^1.3.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2102.0",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.26",
    "@angular/compiler": "^21.2.25",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-rxjs": "^5.0.3",
    "jasmine-core": "~4.6.0",
    "jasmine-marbles": "~0.9.2",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-htmlfile-reporter": "~0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-junit-reporter": "~2.0.1",
    "karma-ng-html2js-preprocessor": "^1.0.0",
    "ng-packagr": "^21.2.7",
    "serverless": "npm:osls@^4.4.0",
    "ts-node": "~10.9.0",
    "typedoc": "^0.27.9",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "esbuild": "0.28.2",
    "uuid": "11.1.1",
    "argparse": "2.0.1"
  }
}
